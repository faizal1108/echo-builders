# Google Gemini (optional — can also be entered in Settings)
# Never commit real keys. Frontend keys can be extracted by users.
VITE_GEMINI_API_KEY=

# Official Bhuvan / NRSC API catalog: https://bhuvan-app1.nrsc.gov.in/api/
# Do not invent undocumented endpoints. Paste the URL from Bhuvan's API documentation
# after you obtain an access token for the chosen theme (e.g. LULC 250K AOI Wise).
VITE_BHUVAN_API_URL=
VITE_BHUVAN_API_TOKEN=

# Optional pest/disease detector POST endpoint (FormData field: image).
# If empty, the Crop Journey scan uses structured demo results.
VITE_PEST_DETECT_URL=
